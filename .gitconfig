[alias]
  uncommit = reset --soft HEAD~1
  unstage = reset HEAD
[commit]
  gpgsign = true
[column]
  ui = auto
[credential]
  helper = store
[diff]
  algorithm = histogram
[fetch]
  prune = true
[gpg]
  format = ssh
[init]
  defaultbranch = main
[merge]
  conflictstyle = zdiff3
[pull]
  rebase = true
[push]
  autosetupremote = true
  default = current
[rebase]
  autosquash = true
  autostash = true
[rerere]
  enabled = true
  autoupdate = true
[tag]
  gpgsign = true
[url "git@github.com:"]
  insteadof = https://github.com/
[user]
  name = Rishav Dhar
  email = 19497993+rdhar@users.noreply.github.com
  signingkey = ~/.ssh/id_ed25519

# https://github.com/rdhar/dotfiles/blob/main/.gitconfig
